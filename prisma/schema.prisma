generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct connection; the pooled URL cannot run DDL.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  /// "personal" or "organization"; null until the account has been through onboarding.
  accountType   String?
  companyName   String?
  credits       Int       @default(2000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  apiKeys      ApiKey[]
  usageLogs    UsageLog[]
  researchRuns ResearchRun[]
  monitors     Monitor[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  name          String
  keyHash       String    @unique
  keyPrefix     String
  revoked       Boolean   @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  /// Optional expiry. A key past this moment is refused like a revoked one, so
  /// a leaked key stops working even if nobody notices to revoke it.
  expiresAt     DateTime?
  /// Shared secret used to sign this key's monitor webhooks.
  webhookSecret String?

  /// Opt-in features for this key. Web search is always available and is not
  /// listed here; everything else has to be granted explicitly.
  capabilities    String[] @default([])
  /// Requests per minute allowed on this key.
  rateLimitPerMin Int      @default(60)
  /// Optional ceiling on credits this key may spend, independent of the
  /// account balance. Null means "only the account balance applies".
  creditCap       Int?
  creditsSpent    Int      @default(0)
  /// When non-empty, browsing and content fetching are restricted to these hosts.
  allowedDomains  String[] @default([])
  blockedDomains  String[] @default([])

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs    UsageLog[]
  researchRuns ResearchRun[]
  monitors     Monitor[]

  @@index([userId])
}

model UsageLog {
  id          String   @id @default(cuid())
  userId      String
  apiKeyId    String
  /// "search" | "research" | "browse" | "monitor"
  operation   String   @default("search")
  query       String
  resultCount Int
  creditsUsed Int
  /// Which discovery provider answered, or the merged source list.
  provider    String?
  latencyMs   Int      @default(0)
  cacheHit    Boolean  @default(false)
  steps       Int      @default(0)
  success     Boolean  @default(true)
  errorCode   String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

/// Search results keyed by normalised query, so repeated questions cost
/// nothing. Rows carry their own expiry; a request asking for fresher data
/// than a row can offer bypasses it.
model SearchCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique
  query      String
  payload    Json
  /// Freshness window the cached payload was produced under, in hours.
  freshnessH Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  hits       Int      @default(0)

  @@index([expiresAt])
}

model ResearchRun {
  id           String    @id @default(cuid())
  userId       String
  apiKeyId     String
  question     String
  depth        String    @default("standard")
  /// "running" | "completed" | "failed"
  status       String    @default("running")
  report       Json?
  sourcesCount Int       @default(0)
  searchCount  Int       @default(0)
  creditsUsed  Int       @default(0)
  errorCode    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
}

model Monitor {
  id              String    @id @default(cuid())
  userId          String
  apiKeyId        String
  /// "url" watches a page; "query" watches a search for new results.
  type            String
  target          String
  webhookUrl      String?
  intervalMinutes Int       @default(60)
  active          Boolean   @default(true)
  /// Hash of the last observed content, used to detect change cheaply.
  lastHash        String?
  lastSnapshot    String?   @db.Text
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey         @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  events MonitorEvent[]

  @@index([userId])
  @@index([active, lastCheckedAt])
}

model MonitorEvent {
  id         String   @id @default(cuid())
  monitorId  String
  /// "content_changed" | "new_results" | "unreachable"
  changeType String
  summary    String
  payload    Json?
  delivered  Boolean  @default(false)
  createdAt  DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
}

/// Fixed-window counter shared by every serverless instance. In-memory limits
/// are meaningless on Vercel — each lambda gets its own heap, so an attacker
/// only has to spread requests across cold starts to bypass them entirely.
model RateLimit {
  /// "<action>:<subject>:<window start epoch>", e.g. "register:ip:1.2.3.4:29803460".
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Append-only trail of security-relevant events, kept separate from UsageLog
/// so that throttling and account activity stay readable when usage is noisy.
model SecurityEvent {
  id        String   @id @default(cuid())
  /// "login_failed" | "login_locked" | "signup" | "signup_throttled" |
  /// "key_created" | "key_revoked" | "rate_limited" | "auth_link_blocked"
  kind      String
  /// Set when the actor is a known account.
  userId    String?
  /// Truncated identifier for the caller: hashed IP, never the raw address.
  actorHash String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}
