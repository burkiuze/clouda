# Postgres. Two URLs: the transaction-pooled one the app uses at runtime, and
# a session one for migrations (transaction mode cannot run DDL).
# Supabase: Connect -> Transaction pooler / Session pooler.
#
# Both must go through the pooler on Vercel. Supabase's direct host
# (db.<ref>.supabase.co) only has an AAAA record on the free plan, and Vercel
# functions are IPv4-only, so a direct URL there fails to connect.
DATABASE_URL="postgresql://<user>.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://<user>.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Auth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Your deployed URL, e.g. https://clouda.vercel.app (not needed on Vercel prod,
# it is inferred, but useful for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must be: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Credits granted to every new account on signup
SIGNUP_FREE_CREDITS=2000

# No search provider key exists: discovery runs entirely on open indexes
# (Marginalia for the open web, plus Wikipedia, Stack Exchange, GitHub,
# Hacker News, Google News, OpenAlex and npm).

# Optional: raises the GitHub provider's rate limit for code/repo results.
GITHUB_TOKEN=""

# Protects the scheduled monitor sweep at /api/cron/monitors.
CRON_SECRET=""
