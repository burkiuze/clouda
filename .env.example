# Clouda North — hiçbiri zorunlu değil.
#
# Dosyayı hiç oluşturmadan `npm run dev` çalışır ve arama yapar. Buradaki her
# değişken bir şeyi açar ya da davranışı değiştirir; hiçbiri kurulum şartı
# değildir. Veritabanı, hesap ve API anahtarı kavramları bu projede yoktur.

# ---------------------------------------------------------------- erişim

# Tanımlıysa her uç "Authorization: Bearer <token>" ister. Yerelde boş bırak;
# loopback dışında bir adrese bağlıyorsan doldur, çünkü o noktada "ulaşabilen
# herkes" artık yalnızca sen değilsin.
CLOUDA_TOKEN=""

# Panelin ve dokümanların bastığı örneklerin doğru adresi göstermesi için.
# Boşsa http://localhost:3000 varsayılır.
NEXT_PUBLIC_APP_URL=""

# ---------------------------------------------------------------- kimlik

# Bazı kaynaklar kim olduğunu sorar ve ciddiye alır: OpenAlex iletişim adresi
# verenlere daha hızlı "polite pool"unu açar, SEC gerçek bir tarafı adlandıran
# User-Agent şart koşar. Varsayılanlar bu projeyi adlandırır — kendi adresini
# yazmazsan gelen hız sınırı isteği yapana değil, adresin sahibine düşer.
CLOUDA_CONTACT_EMAIL=""
CLOUDA_USER_AGENT=""

# --------------------------------------------------------------- kaynaklar

# Marginalia'nın ortak "public" anahtarı varsayılandır ve sınırlıdır.
# Kendi anahtarın varsa buraya yaz.
MARGINALIA_API_KEY=""

# İşlettiğin bir SearXNG sunucusu varsa arama havuzunu genişletir. Sunucuda
# JSON çıktısı açık olmalı. Yalnızca kamuya açık HTTP(S) adresleri kabul
# edilir; özel IP'ler ve localhost reddedilir.
SEARXNG_BASE_URL=""

# GitHub arama sağlayıcısının hız sınırını yükseltir.
GITHUB_TOKEN=""

# ------------------------------------------------------------ tor / onion

# Tor SOCKS5 adresi. Tanımlıysa iki şey açılır: .onion adresleri artık
# reddedilmez ve devre üzerinden okunabilir, ayrıca onion arama kaynağı
# (Ahmia) varsayılan olarak kullanılabilir hale gelir. Tanımlı değilse hiçbir
# şey değişmez — .onion istekleri eskisi gibi engellenir.
# Örnek: socks5://127.0.0.1:9050
TOR_SOCKS_PROXY=""

# Onion aramasını proxy'den bağımsız aç/kapat. Boşsa TOR_SOCKS_PROXY belirler.
# "1" yaparsan Tor kurmadan da onion *adresleri* listelenir (Ahmia normal
# web'den erişilir); sayfaların metnini okumak yine Tor ister. "0" yaparsan
# Tor kurulu olsa bile bu kaynak kapalı kalır.
CLOUDA_ONION_SEARCH=""

# Yalnızca .onion değil, BÜTÜN giden isteklerin Tor'dan geçmesi. Bir devre üç
# aktarma demek: doğrudan birkaç yüz milisaniye süren istek saniyelere çıkar ve
# birçok kaynak çıkış düğümlerini hız sınırına sokar veya bot doğrulaması
# ister. Kurulumun kendi adresini gizlemesi gerekmiyorsa açma.
TOR_ALL_TRAFFIC=""

# ---------------------------------------------------------------- tanılama

# /api/diag/selftest'i açar; o uç çağrı başına ~30 üçüncü tarafa istek yapar.
# Varsayılanı yoktur: tanımlı değilse uç 404 döner.
DIAG_TOKEN=""
