# Postgres connection string. Provision one from the Vercel dashboard:
# Project -> Storage -> Create Database -> Postgres (Neon). Vercel injects
# DATABASE_URL automatically when you connect it to this project.
DATABASE_URL="postgresql://user:password@host:5432/clouda"

# Auth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Your deployed URL, e.g. https://clouda.vercel.app (not needed on Vercel prod,
# it is inferred, but useful for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must be: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Credits granted to every new account on signup
SIGNUP_FREE_CREDITS=2000
